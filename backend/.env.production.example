# ==========================================
# MOONFIT BACKEND - VARIABLES DE PRODUCCIÓN
# ==========================================

# Entorno y Puerto
PORT=3000
NODE_ENV=production

# Base de datos PostgreSQL (Pool limitado a 5 conexiones para ahorrar RAM en VPS)
# Formato: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?connection_limit=5&pool_timeout=10
DATABASE_URL="postgresql://moonfit_user:TU_CONTRASEÑA_SEGURA@localhost:5432/moonfit_prod?connection_limit=5&pool_timeout=10"

# Secretos JWT (Generar con: openssl rand -base64 32)
JWT_ACCESS_SECRET="GENERA_UNA_CLAVE_SECRETA_LARGA_DE_AL_MENOS_32_CARACTERES"
JWT_REFRESH_SECRET="GENERA_OTRA_CLAVE_SECRETA_DISTINTA_DE_AL_MENOS_32_CARACTERES"

# Expiraciones
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION_DAYS=30

# Directorio de Almacenamiento Persistente para Fotos (Progreso, Comidas, Avatares)
STORAGE_PATH="./storage"

# Administrador Inicial para Seed / Configuración
ADMIN_INITIAL_EMAIL="admin@tudominio.com"
ADMIN_INITIAL_PASSWORD="CAMBIA_ESTA_CONTRASEÑA_INMEDIATAMENTE"
